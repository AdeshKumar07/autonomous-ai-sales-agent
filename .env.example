# Root Docker Compose Environment Configuration (Example)
# Copy to .env and replace placeholder values before deploying.

APP_ENV=production
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

POSTGRES_DB=fortivex_ai
POSTGRES_USER=fortivex
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_URL=postgresql+psycopg2://fortivex:change_this_postgres_password@db:5432/fortivex_ai

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHROMA_PERSIST_DIR=/app/chroma_db
